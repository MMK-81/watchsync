# Copy to .env and fill in real values on the server.
# Keep this file in version control; keep .env private.

PUBLIC_ORIGIN=https://watch.example.com
LOG_LEVEL=info
RESOLVER_URL=http://watchsync-resolver:8080
POT_PROVIDER_URL=http://watchsync-bgutil:4416
STREAMS_TMPFS_SIZE=512m
REGISTRATION_ENABLED=true
MAX_ROOMS_PER_USER=5
COOKIE_SECURE=true
ALLOW_PRIVATE_URLS=false
CONTROLLER_NAME=Admin
CONTROLLER_EMAIL=admin@example.com
